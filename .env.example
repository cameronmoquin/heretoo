# Where the web app is served. Both names carry the same value: the
# EXPO_PUBLIC_ one reaches the client bundle, the bare one reaches the
# Netlify functions and build scripts. See constants/site.ts.
EXPO_PUBLIC_SITE_URL=https://nffga.emspcr.app
SITE_URL=https://nffga.emspcr.app

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux (server-side only — used in Edge Functions)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_KEY=

# Mapbox — map tiles for the photo geocache hunt (Leaflet renderer).
# Public pk. token, ships in the browser. Use a URL-restricted token
# in production.
EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Server-only keys (set on Netlify, never shipped to the client) ──
# Every feature below has a graceful "not configured" path: leave a key
# unset and that capability is simply off, with a clear in-app message.

# ElevenLabs — read-aloud (TTS) and speech-to-text
ELEVENLABS_API_KEY=

# Resend — email digests, invites, password reset
RESEND_API_KEY=

# Stripe — subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

