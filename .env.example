# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux (server-side only — used in Edge Functions)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# PostHog Analytics
EXPO_PUBLIC_POSTHOG_KEY=

# Mapbox — map tiles for the photo geocache hunt (Leaflet renderer).
# Public pk. token, ships in the browser. Use the URL-restricted
# "heretoo-social-web" token in production.
EXPO_PUBLIC_MAPBOX_TOKEN=

# ── Server-only keys (set on Netlify, never shipped to the client) ──
# Every feature below has a graceful "not configured" path: leave a key
# unset and that capability is simply off, with a clear in-app message.

# Anthropic — memoir Socratic interview, co-writer, grammar editor,
# reframer. The interview still runs with canned follow-ups if unset.
# The *_MODEL overrides are optional (sane defaults in code).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MEMOIR_MODEL=
ANTHROPIC_COWRITER_MODEL=

# Voice typing (memoir transcription)
TRANSCRIBE_API_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=

# ElevenLabs — read-aloud (TTS) and speech-to-text
ELEVENLABS_API_KEY=

# Resend — email digests, letters, welcome mail
RESEND_API_KEY=

# Stripe — subscriptions ($5/mo ad-free) and donation checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Memoir book render worker (render-worker/ on Render.com).
# "Make the book" fails until both are set; the SECRET must match the
# value set on the Render service. See render-worker/README.md.
MEMOIR_RENDER_WORKER_URL=
MEMOIR_RENDER_SECRET=

# Misc feature config
CHORUS_PROFILE_ID=
DONATION_BENEFICIARY_NAME=
