{
  "name": "heretoo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build-info": "node scripts/generate-build-info.mjs",
    "build-og": "node scripts/build-og-cover.mjs",
    "build-favicons": "node scripts/build-favicon-pngs.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .expo node_modules/.cache",
    "build": "npm run build-info && npm run build-favicons && npm run build-og && expo export --platform web && node scripts/copy-build-marker.mjs",
    "test": "npm run typecheck",
    "predeploy": "node scripts/predeploy-check.mjs",
    "predeploy:force": "node scripts/predeploy-check.mjs --force",
    "deploy": "npm run predeploy && npm run build && netlify deploy --prod --dir=dist",
    "deploy:force": "npm run predeploy:force && npm run build && netlify deploy --prod --dir=dist",
    "deploy:force-clean": "npm run clean && npm install && npm run predeploy:force && npm run build && netlify deploy --prod --dir=dist",
    "verify": "curl -s https://heretoo.social/_build.txt && echo"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.0",
    "@types/leaflet": "^1.9.21",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.10",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-video": "~3.0.16",
    "leaflet": "^1.9.4",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@netlify/functions": "^5.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "~19.1.0",
    "pg": "^8.20.0",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
