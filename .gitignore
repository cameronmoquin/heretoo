# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local Netlify folder
.netlify

# Auto-generated build marker (regenerated on every build)
public/_build.txt

# Local tooling / secrets
.claude/settings.local.json
muxAPI.txt
# Note: constants/build-info.ts IS committed with a placeholder value,
# and overwritten on every build. This way TypeScript always compiles
# even on a fresh clone before running build-info.
brain/
.claude/scheduled_tasks.lock
