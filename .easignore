# Files EAS shouldn't bundle into the build worker upload.
# This is on TOP of .gitignore — anything ignored by git is already skipped.

# Web-only build output
dist/
web-build/
.netlify/

# Documentation / scripts that don't ship with the native app
scripts/
supabase/
*.md

# Local dev caches
.expo/
.expo-shared/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
coverage/
__tests__/
**/*.test.ts
**/*.test.tsx

# Source-control noise
.github/
